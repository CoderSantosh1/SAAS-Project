# Copy to .env.local and fill in values from Supabase > Project Settings > API.

# Safe for the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The hostname customers point their custom domain's CNAME record at.
# Defaults to sites.<host of NEXT_PUBLIC_SITE_URL>.
NEXT_PUBLIC_SITES_CNAME_TARGET=
